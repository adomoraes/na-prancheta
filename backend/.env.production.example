# ==============================================================================
# ⚽ Na Prancheta — Configurações de Ambiente de Produção (Backend)
# ==============================================================================

APP_NAME="Na Prancheta"
APP_ENV=production
APP_KEY=base64:COLOQUE_AQUI_SUA_CHAVE_GERADA_COM_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://api.seudominio.com.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

# Conexão com o Banco de Dados PostgreSQL 16
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=na_prancheta
DB_USERNAME=postgres
DB_PASSWORD=DEFINA_UMA_SENHA_FORTE_AQUI

# Drivers de Produção Otimizados
SESSION_DRIVER=database
SESSION_LIFETIME=1440
CACHE_STORE=database
QUEUE_CONNECTION=database

# CORS e Domínios do Frontend (evita bloqueios de requisições no navegador)
FRONTEND_URL=https://app.seudominio.com.br
SANCTUM_STATEFUL_DOMAINS=app.seudominio.com.br,seudominio.com.br

# Google Gemini API (Opcional - para recursos generativos assistidos por IA)
GEMINI_API_KEY=AIzaSy...
